# XCMG Manufacturing RCA Agent 环境配置

# Docker Compose 仅部署 API；PostgreSQL 使用现成外部数据库。
# schema 由下方 DATABASE_SCHEMA / BUSINESS_DATABASE_SCHEMA / VECTOR_DB_SCHEMA 控制，无需写在 URL 里。

# 业务持久化数据库（PostgreSQL）
# 用于保存 RCA 任务、报告、检查点、工具去重记录和示例业务数据。
# 注意：向量数据库请使用独立 VECTOR_DB_* 配置，不要混用 DATABASE_URL。
# 将 host、port、db、user、password 替换为你的现有 PostgreSQL。
DATABASE_URL=postgresql://rca_user:rca_password@postgres.example.com:5432/xcmg_rca
DATABASE_SCHEMA=rca

# 业务数据库（只读）
# Text2SQL 和业务工具（工单/设备/物料/质量/接口）查询此库。
# 生产环境应指向独立的业务系统数据库（或只读副本），使用只读账号。
BUSINESS_DATABASE_URL=postgresql://rca_user:rca_password@postgres.example.com:5432/xcmg_rca
BUSINESS_DATABASE_SCHEMA=public

# 服务配置
API_HOST=localhost
API_PORT=8000
DEBUG=false

# RAG 配置
# RAG_SOURCE_DIR 保存原始知识文档；RAG_CHUNKS_DIR 保存人工确认后的 jsonl 分块文件。
# 向量入库脚本只读取 RAG_CHUNKS_DIR，并按 chunk id、content_hash、metadata_hash 做增量同步。
# RAG_INDEX_MODE=manual 表示禁止启动时自动初始化知识库向量，必须人工确认分块后手动入库。
RAG_SOURCE_DIR=./app/data/knowledge/raw
RAG_CHUNKS_DIR=./app/data/knowledge/chunks
RAG_INDEX_MODE=manual
RAG_CHUNK_FILE_PATTERN=**/*.jsonl
RAG_DEACTIVATE_MISSING_CHUNKS=true
RAG_REEMBED_ON_CONTENT_CHANGE=true
RAG_UPDATE_METADATA_ONLY=true
RAG_TOP_K=5

# 向量数据库配置
# 用于保存知识库文档的 Embedding 向量；与业务持久化 DATABASE_URL 分离。
# VECTOR_DB_PROVIDER 可选：pgvector、chroma
VECTOR_DB_PROVIDER=pgvector
VECTOR_DATABASE_URL=postgresql://rca_user:rca_password@postgres.example.com:5432/xcmg_rca
VECTOR_DB_SCHEMA=rca_vector
VECTOR_TABLE_NAME=knowledge_embeddings

# 大模型配置
# 说明：项目将接入真实 LLM、Embedding 与 Reranker。
# 所有 *_API_KEY 请在本地 .env 中填写真实密钥，不要提交到 Git。

# LLM 配置：用于症状分析、假设生成、RCA 草稿、反思与报告生成
# LLM_PROVIDER 可选：openai、ollama、compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Embedding 配置：用于将知识库文本与查询转换为向量
# EMBEDDING_PROVIDER 可选：openai、ollama、compatible
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# Reranker 配置：用于对 RAG 初召回结果进行重排序
# RERANKER_PROVIDER 可选：local、http、compatible、none
RERANKER_PROVIDER=ollama
RERANKER_MODEL=dengcao/Qwen3-Reranker-4B:Q4_K_M
RERANKER_BASE_URL=http://localhost:11434
RERANKER_API_KEY=ollama
RERANKER_TOP_N=5

# OpenAI 兼容本地服务示例（如 Ollama/vLLM/LiteLLM）
# 如使用本地兼容服务，可在 .env 中覆盖上面的配置：
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:14b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_DIMENSION=1024

# 工作流配置
# MAX_REFLECTION_ROUNDS：最大反思轮次，达到后强制 PROCEED
# CONFIDENCE_THRESHOLD：综合得分达标线，>= 此值直接 PROCEED
# REFLECTION_LOW_SCORE_THRESHOLD：综合得分下限，< 此值视为证据严重不足
MAX_REFLECTION_ROUNDS=3
CONFIDENCE_THRESHOLD=0.7
REFLECTION_LOW_SCORE_THRESHOLD=0.4

# Text2SQL 配置
TEXT2SQL_WHITELIST_TABLES=work_orders,equipment_maintenance,material_inventory,quality_records,interface_logs
TEXT2SQL_MAX_LIMIT=100

# 日志
LOG_LEVEL=INFO
